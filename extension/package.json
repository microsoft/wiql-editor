{
  "scripts": {
    "clean:vsix": "rimraf *.vsix",
    "clean": "npm run clean:vsix && rimraf dist",
    "compile:css": "sass ./styles:./dist/",
    "build:dev": "npm run clean &&  npm run compile:css && webpack --progress --mode development",
    "build:release": "npm run clean && npm run compile:css && webpack --progress --mode production ",
    "package:dev": "npm run clean:vsix && node ./package/packageDev",
    "package:test": "npm run clean:vsix && node ./package/packageTest",
    "package:prod": "npm run clean:vsix && node ./package/packageProd",
    "dev": "npm run build:dev && webpack-dev-server --hot --progress",
    "dev:serve": "webpack-dev-server --hot --progress"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.16",
    "@types/knockout": "^3.4.72",
    "@types/react": "^16.14.60",
    "@types/react-dom": "^16.9.24",
    "@microsoft/applicationinsights-web": "^3.3.4",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.11.0",
    "del": "^6.1.1",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.9.1",
    "monaco-editor": "^0.21.3",
    "promise-polyfill": "^8.3.0",
    "raw-loader": "^4.0.2",
    "rimraf": "^3.0.2",
    "sass": "^1.80.6",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "tfx-cli": "^0.21.1",
    "ts-loader": "^9.5.2",
    "tslint": "^6.1.3",
    "tslint-loader": "^3.6.0",
    "typescript": "^5.6.3",
    "webpack": "^5.105.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.258.0",
    "azure-devops-extension-sdk": "^4.0.2",
    "azure-devops-ui": "^2.259.0",
    "jquery": "^3.7.1",
    "monaco-editor-webpack-plugin": "^2.1.0",
    "react": "^16.14.0",
    "react-dom": "^16.14.0"
  },
  "name": "wiql-editor",
  "private": true,
  "version": "0.6.0"
